---
import '../styles/global.css';
import { site } from '../data/site';
import { formacion, idiomas } from '../data/cv';
import Nav from '../components/Nav.astro';
import { t, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  titulo?: string;
  descripcion?: string;
  /** La ruta de ESTA página, para la canónica. */
  ruta: string;
  /** La misma página en los dos idiomas: de aquí salen hreflang y el selector. */
  alternativas: { idioma: Idioma; ruta: string }[];
  noindex?: boolean;
}

const { idioma, ruta, alternativas, noindex = false } = Astro.props;
const d = t(idioma);
const titulo = Astro.props.titulo ?? d.meta.titulo;
const descripcion = Astro.props.descripcion ?? d.meta.descripcion;

const canonica = new URL(ruta, site.url).href;
const ogImagen = new URL('/og.png', site.url).href;

/* Datos estructurados: una sola entidad, Person.
   Es lo que sostiene la búsqueda por nombre y lo que puede leer un sistema de
   selección. No añado ProfessionalService ni Organization: no vendo nada aquí,
   y declarar entidades que no existen es la clase de dato que luego no cuadra. */
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#persona`,
      name: site.nombre,
      url: site.url,
      email: `mailto:${site.email}`,
      telephone: site.telefono,
      jobTitle: site.rol[idioma],
      description: descripcion,
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.ubicacion.ciudad,
        addressRegion: site.ubicacion.region,
        addressCountry: 'ES',
      },
      knowsAbout: [
        'Front-end development',
        'Astro',
        'TypeScript',
        'JavaScript',
        'CSS',
        'Web accessibility',
        'Web performance',
        'Internationalization',
        'Technical SEO',
      ],
      knowsLanguage: idiomas.map((i) => ({
        '@type': 'Language',
        name: i.idioma.en,
      })),
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: formacion[0].centro,
      },
      sameAs: [site.linkedin, site.github],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#web`,
      url: site.url,
      name: site.nombre,
      inLanguage: d.meta.htmlLang,
      publisher: { '@id': `${site.url}/#persona` },
    },
  ],
};
---

<!doctype html>
<html lang={d.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="author" content={site.nombre} />
    <meta name="theme-color" content="#f1f0ec" />

    {/* hreflang recíproco: cada versión declara a la otra y a sí misma, más
        x-default apuntando al castellano. Sin la recíproca, Google trata las
        dos páginas como duplicados y elige él cuál enseña. */}
    {
      alternativas.map((a) => (
        <link
          rel="alternate"
          hreflang={a.idioma}
          href={new URL(a.ruta, site.url).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternativas.find((a) => a.idioma === 'es')?.ruta ?? '/', site.url).href}
    />

    {/* Las dos que pintan la primera pantalla se piden a la vez que el HTML:
        Fraunces hace el titular y Geist todo lo demás. La mono no entra aquí
        porque solo aparece en etiquetas pequeñas. */}
    <link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={d.meta.locale} />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.nombre}, ${site.rol[idioma].toLowerCase()}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={ogImagen} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>

  <body>
    <a class="saltar" href="#contenido">{d.saltar}</a>

    <Nav idioma={idioma} alternativas={alternativas} />

    <slot />

    {/* ~1,3 KB: las apariciones y el formulario. Nada más. */}
    <script src="../scripts/main.js"></script>
  </body>
</html>
