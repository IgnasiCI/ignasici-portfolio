# Cabeceras de Cloudflare Pages.

# Todo lo que lleva huella en el nombre puede guardarse para siempre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.png
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # El CSS va incrustado en el HTML: por eso 'unsafe-inline' en style-src.
  # Los scripts en línea (los datos estructurados) NO usan 'unsafe-inline':
  # tools/csp.mjs calcula su hash en cada compilación y lo escribe aquí.
  # form-action 'self': el formulario solo puede enviar a este dominio, así que
  # un script inyectado no podría redirigir los datos a otro sitio.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-REEMPLAZAR'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
